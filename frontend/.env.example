# Copy to .env.local and fill in. Local dev defaults to the local backend.
# Deployed values come from the stack outputs; see docs/deployment.md.
VITE_API_URL=http://localhost:8000
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=us-east-1
# Cognito hosted sign-in domain (stack output CognitoDomain), used for Google sign-in
VITE_COGNITO_DOMAIN=
